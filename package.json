{
  "name": "pi-jar",
  "version": "0.1.0",
  "description": "Role-aware animated theme and TUI extension for Pi, inspired by Setara x Punakawan.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrip/pi-jar.git"
