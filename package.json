{
  "name": "pi-jar",
  "version": "0.1.0",
  "description": "Role-aware animated theme and TUI extension for Pi, inspired by Setara x Punakawan.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrip/pi-jar.git"
  },
  "homepage": "https://github.com/ygrip/pi-jar#readme",
  "bugs": {
    "url": "https://github.com/ygrip/pi-jar/issues"
  },
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "terminal",
    "multi-agent"
  ],
  "files": [
    "extensions",
    "src",
    "themes",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "themes:build": "node --experimental-strip-types scripts/build-accents.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": { "node": ">=22.6" },
  "dependencies": {
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typescript": "5.9.2"
  }
}
