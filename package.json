{
  "name": "pi-jar",
  "version": "0.1.0",
  "description": "A warm, role-aware Pi terminal workspace with animated UI, plan and goal workflows, tasks, change review, model roles, background shells and subagents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygrip/pi-jar.git"
  },
  "homepage": "https://github.com/ygrip/pi-jar#readme",
  "bugs": {
    "url": "https://github.com/ygrip/pi-jar/issues"
  },
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension",
    "terminal",
    "multi-agent",
    "plan-mode",
    "goal",
    "model-roles"
  ],
  "files": [
    "extensions",
    "src",
    "themes",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "themes:build": "node --experimental-strip-types scripts/build-accents.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "typebox": "^1.3.34",
    "typescript": "5.9.2"
  }
}
